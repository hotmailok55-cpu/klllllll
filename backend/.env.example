# =============================================================================
# Loop — example environment configuration
#
# Copy this file to `.env` and fill in real values, OR export these as real
# environment variables (which is what you should do in production).
#
#   cp .env.example .env
#
# EVERY VALUE HERE IS FAKE. Never commit a real secret to the repository.
# In production, load these from your platform's secret manager rather than
# from a file on disk.
# =============================================================================

# -----------------------------------------------------------------------------
# CORE
# -----------------------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# The public URL of this API. Used to build links in emails (verification,
# password reset), so it must be reachable by your users.
PUBLIC_URL=http://localhost:4000

# How chatty the logs are: debug | info | warn | error
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# SECURITY  (required in production)
# -----------------------------------------------------------------------------

# Signs and validates session tokens. MUST be set in production — the server
# refuses to boot without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=replace-me-with-a-long-random-value

# Session lifetime in seconds. Default is 7 days.
AUTH_TOKEN_TTL=604800

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------

# SQLite file path for development. In production point your database adapter
# at a managed database instead — see docs/ARCHITECTURE.md.
DATABASE_FILE=./data/platform.db

# -----------------------------------------------------------------------------
# STORAGE  (where video FILES live — never the database)
# -----------------------------------------------------------------------------

# local  = filesystem (development, small deployments)
# object = S3 / GCS / R2 (implement the adapter first)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/uploads

# Only used by the object driver.
STORAGE_BUCKET=my-video-bucket

# When set, ALL media URLs point at the CDN instead of this server, so large
# files never stream through the application. Leave blank in development.
CDN_URL=

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_DEFAULT_MAX=300

# -----------------------------------------------------------------------------
# FEATURE FLAGS
#
# Turn features on and off without a code change. (spec §63)
# -----------------------------------------------------------------------------
SHORTS_ENABLED=true
LIVE_STREAMING_ENABLED=false
MONETIZATION_ENABLED=false
MUSIC_API_ENABLED=false
AI_MODERATION_ENABLED=false
COPYRIGHT_CHECK_ENABLED=true
REGISTRATION_ENABLED=true

# =============================================================================
# EXTERNAL INTEGRATIONS
#
# Every one of these is OPTIONAL. With none configured the platform runs
# normally: uploads work, moderation uses internal rules, copyright checks
# report "pending" rather than falsely reporting "clear".
#
# To connect a provider you need TWO things:
#   1. an adapter in src/integrations/<capability>/  (see docs/ADDING-AN-API.md)
#   2. the variables below
# =============================================================================

# --- Copyright detection ------------------------------------------------------
# 'null' means no provider. Set to the name you registered your adapter under.
COPYRIGHT_PROVIDER=null
COPYRIGHT_API_KEY=
COPYRIGHT_API_URL=

# --- Music library / licensing ------------------------------------------------
# Remember: connecting this does NOT grant rights to any track. Rights are
# checked per track, per usage, and only 'cleared' tracks are offered.
MUSIC_PROVIDER=null
MUSIC_API_KEY=
MUSIC_API_URL=

# --- Content moderation --------------------------------------------------------
# 'internal' uses the built-in rules only. An external provider ADDS signals;
# the platform's own policy engine still makes every decision.
MODERATION_PROVIDER=internal
MODERATION_API_KEY=
MODERATION_API_URL=

# --- Analytics -----------------------------------------------------------------
# 'internal' keeps every event in our own database. An external provider is a
# mirror, never the source of truth.
ANALYTICS_PROVIDER=internal
ANALYTICS_API_KEY=

# --- Payments / monetization ---------------------------------------------------
PAYMENTS_PROVIDER=null
PAYMENTS_API_KEY=

# --- Notification delivery (email / push) --------------------------------------
# 'internal' logs what would have been sent, so local development works with no
# mail service. In-app notifications always work regardless.
NOTIFICATIONS_PROVIDER=internal
NOTIFICATIONS_API_KEY=

# --- AI (captions, categorization, moderation assistance) ----------------------
AI_PROVIDER=null
AI_API_KEY=
