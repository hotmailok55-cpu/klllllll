<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- A video feed reads best on a dark ground, so the app commits to dark.
         Compose paints the real colours; this theme just stops a white flash
         between launch and first frame. -->
    <style name="Theme.LjbmkSocial" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>
</resources>
